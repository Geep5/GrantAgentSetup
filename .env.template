# ===== identity =====
AGENT_NAME=myagent                  # short slug: logs, dashboard markers
# PRESENCE_ACTIVITY=the task board  # shown as "Watching ..." if presence daemon used

# ===== discord (required) =====
DISCORD_BOT_TOKEN=
# The bot's private coordination channel with the Graice hub — auth hand-offs,
# retries, status. Grant's channel above stays HIS conversation with the bot.
# The bot listens on both and replies to whichever asked. See COORDINATION.md.
COORD_CHANNEL_ID=

# Services this bot cannot work without, comma-separated. Lets the coordinator
# say "Marco is blocked" instead of "something is blocked".
NEEDS=

DISCORD_CHANNEL_ID=
# PEER_CHANNEL_ID=                  # optional: shared channel with a peer bot (ask_peer.py)

# ===== brain =====
OMP_MODEL=claude-opus-5:xhigh
OMP_BIN=~/.local/bin/omp
POLL_INTERVAL=3
AGENT_TIMEOUT=3000                  # seconds per agent turn (50 min)
# PYTHON_BIN=                       # set if `python3` isn't >= 3.10 on PATH

# ===== anytype board (optional trio — all three or none) =====
ANYTYPE_API_KEY=
ANYTYPE_SPACE_ID=
ANYTYPE_BOARD_ID=                   # the task TYPE object id (doubles as list id)
SEND_DATE_KEY=send_date             # actual key of the Send Date property

# ===== dashboards (optional) =====
# CRONY_TOML=/path/to/crony.toml    # mirror pending sends into a Crony TUI file
# SEND_EMOJI=✉️

# ===== cron-proofing: pin a full PATH (cron's default is bare /usr/bin:/bin) =====
PATH=/opt/homebrew/bin:~/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# ===== Google Workspace (optional) =====
# Comma-separated list of Google identities THIS bot may act as. Setting it
# makes start.sh verify each one at boot; the agent then picks per command with
# ./gws-as <account> <gws args>. Same class of cron-proofing as the PATH pinning
# above: the default OS keychain cannot be unlocked from cron, and a shared
# config dir lets one bot's decrypt failure DELETE auth for every bot.
#   1. once per account, with a browser:  ./gws-bootstrap.sh <account>
#   2. per bot, any time (no browser):    ./gws-seed.sh <bot-runtime-dir>
# See GWS.md for the full model.
# GWS_ACCOUNTS=first@example.com,second@example.com
